    {
      "index": 6,
      "scene": "P3",
      "text": "不急着问原因，您先陪我说一会儿话，好不好？",
      "duration_seconds": 4.877,
      "turn_run_id": "rpturn_276106fc22449f0e8616d6b2e4c53d3e1eae76ab6fe9d68416181e631d3772ab",
